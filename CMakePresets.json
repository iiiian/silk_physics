{
  "version": 5,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "1"
      }
    },
    {
      "name": "linux_debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CUDA_FLAGS": "-lineinfo",
        "VCPKG_OVERLAY_PORTS": {
          "value": "${sourceDir}/cmake/vcpkg-ports",
          "type": "PATH"
        }
      }
    },
    {
      "name": "linux_profile",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CUDA_FLAGS": "-lineinfo",
        "VCPKG_OVERLAY_PORTS": {
          "value": "${sourceDir}/cmake/vcpkg-ports",
          "type": "PATH"
        }
      }
    },
    {
      "name": "linux_release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_OVERLAY_PORTS": {
          "value": "${sourceDir}/cmake/vcpkg-ports",
          "type": "PATH"
        }
      }
    }
  ]
}
